\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{project-format}

\RequirePackage[
	a4paper,
	left=2.0cm,
	right=2.0cm,
	top=2.0cm,
	bottom=2.0cm]{geometry}


\numberwithin{equation}{section}
\setcounter{tocdepth}{3}
\setcounter{secnumdepth}{3}
\setlist[itemize]{leftmargin=1.55em,itemsep=0.22em,topsep=0.35em}
\setlist[enumerate]{leftmargin=1.8em,itemsep=0.25em,topsep=0.35em}

% -----------------------------------------------------------------------------
% Heading hierarchy
% -----------------------------------------------------------------------------
% Every structural title uses the same normal-weight small-capitals style.
% Hierarchy is conveyed by size alone, except for the requested rules:
%   * parts: one rule above and one rule below;
%   * sections: one rule below.
\RequirePackage{titlesec}

% The article-class \part command is redefined directly because its layout is
% structurally different from the lower heading levels.  This preserves
% numbering, optional short titles, bookmarks, and table-of-contents entries.
\makeatletter
\renewcommand\part{%
	\if@noskipsec \leavevmode \fi
	\par
	\addvspace{4ex}%
	\@afterindentfalse
	\secdef\project@part\project@spart}

\def\project@part[#1]#2{%
\ifnum \c@secnumdepth >\m@ne
	\refstepcounter{part}%
	\addcontentsline{toc}{part}{\thepart\hspace{1em}#1}%
\else
	\addcontentsline{toc}{part}{#1}%
\fi
{\parindent\z@\centering\interlinepenalty\@M\normalfont
\noindent\rule{\linewidth}{1.1pt}\par\nobreak
\vspace{0.8ex}%
\ifnum \c@secnumdepth >\m@ne
	{\Large\scshape \partname\nobreakspace\thepart\par\nobreak}%
	\vspace{0.6ex}%
\fi
{\Huge\scshape #2\par\nobreak}%
\vspace{0.8ex}%
\noindent\rule{\linewidth}{1.1pt}\par
\markboth{}{}}%
\nobreak
\vskip 3ex
\@afterheading}

\def\project@spart#1{%
	{\parindent\z@\centering\interlinepenalty\@M\normalfont
			\noindent\rule{\linewidth}{1.1pt}\par\nobreak
			\vspace{0.8ex}%
			{\Huge\scshape #1\par\nobreak}%
			\vspace{0.8ex}%
			\noindent\rule{\linewidth}{1.1pt}\par
			\markboth{}{}}%
	\nobreak
	\vskip 3ex
	\@afterheading}
\makeatother

\titleformat{\section}[block]
{\normalfont\Large\scshape}
{\thesection.}
{0.50cm}
{}
[\vspace{0.35ex}\titlerule]

\titleformat{\subsection}[block]
{\normalfont\large\scshape}
{\thesubsection.}
{0.50cm}
{}

\titleformat{\subsubsection}[block]
{\normalfont\normalsize\scshape}
{\thesubsubsection.}
{0.50cm}
{}

\titleformat{\paragraph}[runin]
{\normalfont\small\scshape}
{\theparagraph.}
{0.50em}
{}

\titleformat{\subparagraph}[runin]
{\normalfont\footnotesize\scshape}
{\thesubparagraph.}
{0.50em}
{}

\titlespacing*{\section}{0pt}{3.0ex plus 1ex minus 0.2ex}{1.8ex}
\titlespacing*{\subsection}{0pt}{2.5ex plus 0.8ex minus 0.2ex}{1.0ex}
\titlespacing*{\subsubsection}{0pt}{2.0ex plus 0.6ex minus 0.2ex}{0.8ex}
\titlespacing*{\paragraph}{0pt}{1.6ex plus 0.4ex minus 0.2ex}{0.7em}
\titlespacing*{\subparagraph}{0pt}{1.4ex plus 0.4ex minus 0.2ex}{0.7em}

% Apply the same visual language to title-like names generated by LaTeX.
\renewcommand{\abstractname}{Abstract}
\renewenvironment{abstract}{%
	\small
	\begin{center}%
		{\normalfont\normalsize\scshape\abstractname\vspace{-0.5em}\vspace{0pt}}%
	\end{center}%
	\quotation}
{\endquotation}

% Small-cap entries in the table of contents, with size preserving hierarchy.
\RequirePackage{tocloft}
\renewcommand{\cfttoctitlefont}{\normalfont\Large\scshape}
\renewcommand{\cftaftertoctitle}{%
	\par\vspace{0.35ex}\noindent\rule{\linewidth}{0.4pt}\par}
\renewcommand{\cftloftitlefont}{\normalfont\Large\scshape}
\renewcommand{\cftafterloftitle}{%
	\par\vspace{0.35ex}\noindent\rule{\linewidth}{0.4pt}\par}
\renewcommand{\cftlottitlefont}{\normalfont\Large\scshape}
\renewcommand{\cftafterlottitle}{%
	\par\vspace{0.35ex}\noindent\rule{\linewidth}{0.4pt}\par}
\renewcommand{\cftpartfont}{\normalfont\large\scshape}
\renewcommand{\cftpartpagefont}{\normalfont\large}
\renewcommand{\cftsecfont}{\normalfont\normalsize\scshape}
\renewcommand{\cftsecpagefont}{\normalfont\normalsize}
\renewcommand{\cftsubsecfont}{\normalfont\small\scshape}
\renewcommand{\cftsubsecpagefont}{\normalfont\small}
\renewcommand{\cftsubsubsecfont}{\normalfont\footnotesize\scshape}
\renewcommand{\cftsubsubsecpagefont}{\normalfont\footnotesize}

\hypersetup{
	colorlinks=true,
	linkcolor=blue!55!black,
	citecolor=green!40!black,
	urlcolor=red!45!black
}
